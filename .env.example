# ============================================
# Configuración de API - Kibo
# ============================================
# COPIA ESTE ARCHIVO A .env Y RELLENA CON TUS VALORES

# URL base de la API
API_BASE_URL=https://api.kibo.aventiscali.com

# API Key para autenticación (obtén esto del administrador del servidor)
API_KEY=tu_api_key_aqui

# ============================================
# Configuración de Google Maps
# ============================================
# Obtén esta clave desde: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=tu_google_maps_api_key

# ============================================
# Configuración de Entorno
# ============================================
# Valores: development, production
ENVIRONMENT=development
